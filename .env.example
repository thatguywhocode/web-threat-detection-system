# ==============================================================================
# SecuNexis — Web Threat Detection Platform Environment Configuration (.env)
# ==============================================================================

# Application environment mode (development | production)
NODE_ENV=production

# Server network binding port (Render assigns this automatically; default 3000 locally)
PORT=3000

# ==============================================================================
# Database Configuration (Persistent MongoDB Atlas SOC Store)
# ==============================================================================
# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/secunexis?retryWrites=true&w=majority

# Set to "true" in strict production deployments to fail-closed if MongoDB is unreachable
REQUIRE_MONGODB=false

# ==============================================================================
# Phase 2.5 Authentication, RBAC & Session Hardening
# ==============================================================================
# Optional one-time initial ADMIN account bootstrap (used ONLY when 0 users exist in DB).
# NEVER commit real passwords to Git. Set these exclusively in Render Environment Variables.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Session duration in milliseconds (default: 28800000 = 8 hours)
SESSION_TTL_MS=28800000

# Bcrypt cost factor (minimum 10; recommended 12 in production)
BCRYPT_ROUNDS=12

# Brute-force account lockout thresholds
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MS=900000

# Cookie SameSite policy (Strict | Lax)
COOKIE_SAMESITE=Strict

# Explicit CORS allowed origins (comma-separated, e.g. https://secunexis.onrender.com)
ALLOWED_ORIGINS=

# ==============================================================================
# Global Threat Intelligence Feeds
# ==============================================================================
# VirusTotal v3 API Key (optional for development; required for reputation feeds)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
