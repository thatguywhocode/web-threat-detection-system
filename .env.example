# ==============================================================================
# SecuNexis — Web Threat Detection Platform Environment Configuration (.env)
# ==============================================================================

# Application environment mode (development | production)
NODE_ENV=production

# Server network binding port (Render assigns this automatically; default 3000 locally)
PORT=3000

# ==============================================================================
# Database Configuration (Persistent SOC SecurityEvent Store)
# ==============================================================================
# MongoDB Atlas Connection URI
# Obtain a free cluster connection string from https://cloud.mongodb.com
# Example:
# MONGODB_URI=mongodb+srv://<db_username>:<db_password>@secunexis-cluster.xxxxx.mongodb.net/secunexis?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/secunexis?retryWrites=true&w=majority

# ==============================================================================
# Global Threat Intelligence Feeds
# ==============================================================================
# VirusTotal v3 API Key (optional for development; required for reputation feeds)
# Obtain a free key at https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
